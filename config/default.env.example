# 股票信息Agent系统配置模板
# 复制此文件为 default.env 并填入真实值

# 邮件推送配置 (QQ邮箱)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的邮箱@qq.com
SMTP_PASS=你的QQ邮箱授权码

# 数据源API配置
COINGECKO_API_KEY=
YAHOO_FINANCE_BASE=https://query1.finance.yahoo.com
EASTMONEY_BASE=https://push2.eastmoney.com

# JWT配置
JWT_SECRET=请修改为随机字符串
JWT_EXPIRES_IN=7d

# 数据库
DB_PATH=./data/stock_agent.db

# 服务器
PORT=3000
