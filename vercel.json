{
  "version": 2,
  "builds": [
    {
      "src": "api/trigger.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/trigger",
      "dest": "/api/trigger.js"
    }
  ],
  "crons": [
    {
      "path": "/api/trigger",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/trigger?mode=review",
      "schedule": "0 10 * * *"
    }
  ]
}
